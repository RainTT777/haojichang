---
interface Item { question: string; answer: string }
interface Props { items: Item[]; title?: string }
const { items, title = '常见问题' } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) };
---
<section class="surface p-6 sm:p-8"><h2 class="mb-5 text-2xl font-black text-ink-950">{title}</h2><div class="grid gap-3">{items.map((item, index) => <details class="group rounded-2xl border border-slate-200 bg-slate-50/70 p-5" open={index === 0}><summary class="cursor-pointer list-none pr-8 font-bold text-slate-800">{item.question}</summary><p class="mt-3 text-sm leading-7 text-slate-600">{item.answer}</p></details>)}</div><script type="application/ld+json" set:html={JSON.stringify(schema)} /></section>
