---
interface Props { name: string; description: string; rating: number; price: number; protocol: string; latency: string; unlock: string; href: string; rank?: number }
const { name, description, rating, price, protocol, latency, unlock, rank } = Astro.props;
---
<article class="surface card-hover relative overflow-hidden p-6"><div class="absolute top-0 right-0 h-24 w-24 rounded-bl-[60px] bg-gradient-to-bl from-brand-100 to-transparent"></div>{rank && <span class="relative grid size-9 place-items-center rounded-xl bg-brand-500 text-sm font-black text-white">{rank}</span>}<div class="relative mt-5 flex items-start justify-between gap-4"><div><h3 class="text-xl font-black text-ink-950">{name}</h3><p class="mt-2 text-sm leading-6 text-slate-500">{description}</p></div><span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-black text-amber-600">★ {rating.toFixed(1)}</span></div><dl class="relative mt-5 grid grid-cols-2 gap-2 text-xs"><div class="rounded-xl bg-slate-50 p-3"><dt class="text-slate-400">线路架构</dt><dd class="mt-1 font-bold text-slate-700">{protocol}</dd></div><div class="rounded-xl bg-slate-50 p-3"><dt class="text-slate-400">晚高峰延迟</dt><dd class="mt-1 font-bold text-brand-600">{latency}</dd></div><div class="rounded-xl bg-slate-50 p-3"><dt class="text-slate-400">原生解锁</dt><dd class="mt-1 font-bold text-slate-700">{unlock}</dd></div><div class="rounded-xl bg-slate-50 p-3"><dt class="text-slate-400">起步价格</dt><dd class="mt-1 font-bold text-slate-700">¥{price}/月</dd></div></dl></article>
