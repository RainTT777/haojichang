---
interface Post { title: string; description: string; href: string; meta?: string }
interface Props { posts: Post[]; title?: string }
const { posts, title = '相关阅读' } = Astro.props;
---
<section><h2 class="mb-5 text-2xl font-black text-ink-950">{title}</h2><div class="grid gap-5 md:grid-cols-3">{posts.map((post) => <a href={post.href} class="surface card-hover block p-6"><span class="text-xs font-bold text-brand-600">{post.meta ?? '精选文章'}</span><h3 class="mt-3 text-lg font-black leading-7 text-ink-950">{post.title}</h3><p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-500">{post.description}</p></a>)}</div></section>
