---
interface Stat { value: string; label: string }
interface Props { stats: Stat[] }
const { stats } = Astro.props;
---
<section class="surface grid divide-y divide-slate-100 overflow-hidden sm:grid-cols-2 sm:divide-x sm:divide-y-0 xl:grid-cols-4">{stats.map((stat) => <div class="p-6 text-center"><strong class="block text-2xl font-black text-ink-950">{stat.value}</strong><span class="mt-1 block text-xs font-medium text-slate-500">{stat.label}</span></div>)}</section>
