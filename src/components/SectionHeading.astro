---
interface Props { title: string; description?: string; href?: string; linkLabel?: string }
const { title, description, href, linkLabel = '查看全部' } = Astro.props;
---
<div class="mb-6 flex items-end justify-between gap-4"><div><div class="flex items-center gap-3"><span class="h-6 w-1 rounded-full bg-gradient-to-b from-brand-400 to-sky-600"></span><h2 class="text-2xl font-black tracking-tight text-ink-950">{title}</h2></div>{description && <p class="mt-2 pl-4 text-sm text-slate-500">{description}</p>}</div>{href && <a href={href} class="shrink-0 text-sm font-bold text-brand-600 hover:text-brand-500">{linkLabel} →</a>}</div>
