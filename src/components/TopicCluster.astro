---
interface Topic { title: string; description: string; href: string; count?: number }
interface Props { topics: Topic[] }
const { topics } = Astro.props;
---
<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">{topics.map((topic, index) => <a href={topic.href} class="surface card-hover group block p-6"><span class="grid size-11 place-items-center rounded-2xl bg-gradient-to-br from-brand-50 to-cyan-100 font-black text-brand-600">0{index + 1}</span><h3 class="mt-5 text-lg font-black text-ink-950 group-hover:text-brand-600">{topic.title}</h3><p class="mt-2 text-sm leading-6 text-slate-500">{topic.description}</p>{topic.count && <span class="mt-5 block text-xs font-bold text-slate-400">{topic.count} 篇内容</span>}</a>)}</div>
