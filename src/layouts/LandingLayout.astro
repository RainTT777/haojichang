---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; eyebrow?: string }
const { title, description, eyebrow = '好机场内容专题' } = Astro.props;
---
<BaseLayout title={`${title} - 好机场`} description={description}>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <main>
    <section class="landing-hero relative overflow-hidden border-b border-slate-200 bg-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_0%,rgba(50,199,228,.14),transparent_34rem)]"></div>
      <div class="landing-container relative py-10 sm:py-14">
        <span class="text-xs font-black tracking-[.2em] text-brand-600">{eyebrow}</span>
        <h1 class="mt-3 max-w-5xl text-4xl leading-tight font-black tracking-tight text-ink-950 sm:text-5xl">{title}</h1>
        <p class="mt-4 max-w-3xl text-base leading-8 text-slate-500 sm:text-lg">{description}</p>
      </div>
    </section>
    <div class="landing-container py-8 sm:py-10"><slot /></div>
  </main>
</BaseLayout>
