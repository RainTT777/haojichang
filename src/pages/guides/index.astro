---
import BaseLayout from '../../layouts/BaseLayout.astro';
const guides = [
  ['机场是什么？新手入门完整指南','理解机场、VPN、代理节点、订阅链接和客户端之间的关系。','基础入门','/faq/#basics'],
  ['IPLC、IEPL 与公网中转怎么选？','从入口、跨境段、共享带宽与晚高峰表现判断线路类型。','线路科普','/topics/example-topic/'],
  ['2026 稳定机场选购指南','根据预算、设备、流量、倍率、解锁和售后建立选择清单。','选购方法','/blog/example-post/'],
  ['机场倍率与套餐流量如何计算？','看懂 0.5 倍率、1 倍率、2 倍率和不限时套餐的流量规则。','套餐知识','/faq/#purchase'],
  ['机场节点延迟、抖动与丢包怎么看？','避免只看一次峰值测速，建立可重复的晚高峰测试方法。','测速指南','/topics/speed-test/'],
  ['原生 IP、住宅 IP 和数据中心 IP 区别','理解出口 IP 类型对流媒体、ChatGPT 和账号风控的影响。','IP 科普','/faq/#streaming'],
  ['Shadowrocket 订阅导入与规则设置','iPhone 用户从安装、导入到节点切换的完整操作思路。','客户端教程','/category/tutorial/'],
  ['Clash Verge Rev 常见故障排查','解决订阅更新失败、TUN 异常、系统代理冲突和 DNS 问题。','故障解决','/faq/#clients'],
  ['机场跑路前可能出现哪些信号？','识别异常年付促销、客服失联、节点下线和公告停更风险。','风险指南','/alerts/'],
];
---
<BaseLayout title="机场指南 - 机场科普与选购文章 | 好机场" description="机场入门、IPLC IEPL、套餐倍率、节点测速、客户端配置、流媒体与 AI 解锁等 SEO 科普文章。">
  <main class="site-container py-10"><section class="surface mx-auto max-w-7xl p-8 sm:p-12"><span class="text-sm font-black tracking-widest text-cyan-700">AIRPORT GUIDES</span><h1 class="mt-3 text-4xl font-black text-slate-950 sm:text-5xl">机场指南与网络节点科普</h1><p class="mt-5 max-w-4xl text-lg leading-8 text-slate-600">用于持续更新机场选购、线路协议、套餐流量、客户端配置、测速方法、流媒体与 AI 解锁等 SEO 科普文章。</p></section><section class="mx-auto mt-6 grid max-w-7xl gap-4 md:grid-cols-2 xl:grid-cols-3">{guides.map(([title,description,category,href])=><article class="surface card-hover p-6"><span class="text-sm font-bold text-cyan-700">{category}</span><h2 class="mt-2 text-xl font-black text-slate-950"><a href={href}>{title}</a></h2><p class="mt-3 text-sm leading-7 text-slate-600">{description}</p><a href={href} class="mt-5 inline-block text-sm font-bold text-cyan-700">阅读指南 →</a></article>)}</section></main>
</BaseLayout>
