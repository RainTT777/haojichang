---
import BaseLayout from '../../layouts/BaseLayout.astro';
const deals = [
  ['边缘节点 EdgeNova','新用户下单前可尝试使用优惠码。','xk808'],
  ['极连云 JiLianYun','适用于极连云当前可用套餐。','JLY888'],
  ['光年梯 GuangNianTi','适用于光年梯当前可用套餐。','GNT80'],
  ['云图 YunTu','适用于云图当前可用套餐。','yt88'],
  ['速界 SuJie','适用于速界当前可用套餐。','sujie888'],
  ['快狸 KuaiLi','适用于快狸当前可用套餐。','kl888'],
  ['可信云 KeXinYun','适用于可信云当前可用套餐。','kxy80'],
  ['瞬云 ShunYun','目前未提供可公开展示的优惠码。','暂无公开优惠码'],
  ['鲲鹏加速 KunPeng','¥1/GB 起，目前未提供可公开展示的优惠码。','暂无公开优惠码']
];
---
<BaseLayout title="机场优惠与试用活动 - 好机场" description="整理机场优惠码、新用户套餐、限时活动、按量计费与试用信息。">
  <main class="site-container py-10"><section class="surface mx-auto max-w-7xl p-8 sm:p-12"><span class="text-sm font-black tracking-widest text-amber-700">AIRPORT COUPONS</span><h1 class="mt-3 text-4xl font-black text-slate-950 sm:text-5xl">机场优惠码汇总</h1><p class="mt-5 max-w-4xl text-lg leading-8 text-slate-600">集中展示当前收录的机场优惠码，不提供活动跳转按钮。优惠码可能调整或失效，最终折扣以结算页面实际显示为准。</p></section><section class="mx-auto mt-6 grid max-w-7xl gap-4 md:grid-cols-2 xl:grid-cols-3">{deals.map(([name,description,code])=><article class="surface coupon-page-card p-6"><span class="text-sm font-bold text-orange-600">优惠码</span><h2 class="mt-2 text-xl font-black text-slate-950">{name}</h2><p class="mt-3 text-sm leading-7 text-slate-600">{description}</p><div class:list={["coupon-page-code",code==='暂无公开优惠码'&&'coupon-page-code--empty']}><small>{code==='暂无公开优惠码'?'状态':'COUPON CODE'}</small><code>{code}</code></div></article>)}</section></main>
</BaseLayout>
