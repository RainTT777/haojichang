---
import { getCollection } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import TopicCluster from '../../components/TopicCluster.astro';
const entries=await getCollection('topics',({data})=>!data.draft); const topics=entries.map(entry=>({title:entry.data.title,description:entry.data.description,href:`/topics/${entry.id}/`,count:6}));
---
<LandingLayout title="专题中心" description="围绕 IPLC、IEPL、测速、解锁与客户端建立可持续更新的内容集群。" eyebrow="TOPIC CLUSTERS"><TopicCluster topics={topics}/></LandingLayout>
